# Copy to .env.local and fill in. Never commit real values.

# --- Decap/Netlify CMS GitHub OAuth (app/api/auth, app/api/callback) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GoHighLevel (server-only; NEVER prefix these with NEXT_PUBLIC_) ---
# Both are REQUIRED. Without them /api/lead returns 500 and no lead is
# captured — there is deliberately no hardcoded fallback for these two.
#
# Private Integration token. GHL sub-account > Settings > Private Integrations.
# Required scope: contacts.write. Shown once at creation. This is the only
# genuine secret here — mark it "Sensitive" in Vercel.
GHL_PIT=
# The GHL sub-account (location) ID that receives these leads.
GHL_LOCATION_ID=

# --- Optional: GHL custom-field ID overrides ---
# Not needed. The live IDs are checked in as defaults in lib/ghl-fields.ts,
# because they are static and not secret. Set these only to point a preview
# build at a different GHL sub-account, where the IDs would differ.
# GHL_FIELD_COMPANY_SIZE=
# GHL_FIELD_STAFF_REQUIRED=
# GHL_FIELD_STAFF_COUNT=
# GHL_FIELD_MESSAGE=
# GHL_FIELD_SMS_CONSENT=
