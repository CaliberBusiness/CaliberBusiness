# Copy to .env.local and fill in. Never commit real values.

# --- Decap/Netlify CMS GitHub OAuth (app/api/auth, app/api/callback) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GoHighLevel (server-only; NEVER prefix these with NEXT_PUBLIC_) ---
# Private Integration token. GHL sub-account > Settings > Private Integrations.
# Required scope: contacts.write. Shown once at creation.
GHL_PIT=
# The GHL sub-account (location) ID that receives these leads.
GHL_LOCATION_ID=

# --- GHL custom-field IDs (not secrets; they differ per sub-account) ---
# Live IDs for the current location are in the comment on each line — paste the
# value after the "=" to use them. Anything left blank is omitted from the
# payload, costing that one answer rather than the whole lead.
# Company Size (dropdown; values stored with EN DASHES) -> ohOizYLdqRh5JSOr2jg6
GHL_FIELD_COMPANY_SIZE=
# No. of Staff Required (dropdown; EN DASHES) -> O7fycmawxy1Ei377QWOR
GHL_FIELD_STAFF_REQUIRED=
# Staff Count (free text; the form's numeric input) -> ZZBsL3gzfxBmjSN1DYj0
GHL_FIELD_STAFF_COUNT=
# Message (multi-line) -> AUL2fZm9cCG38MRVWlxl
GHL_FIELD_MESSAGE=
# SMS Consent ("Yes" / "No") -> VtoRSUcsHvG2exax3DUy
GHL_FIELD_SMS_CONSENT=
